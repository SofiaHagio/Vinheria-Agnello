      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://{{url}}:4041/iot/about"
        }
      }
    },
    {
      "name": "3. Health check STH-Comet",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://{{url}}:8666/version"
        }
      }
    },
    {
      "name": "4. Criar service group",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "fiware-service",
            "value": "smart"
          },
          {
            "key": "fiware-servicepath",
            "value": "/"
          }
        ],
        "url": {
          "raw": "http://{{url}}:4041/iot/services"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"services\": [\n    {\n      \"apikey\": \"TEF\",\n      \"cbroker\": \"http://{{url}}:1026\",\n      \"entity_type\": \"Thing\",\n      \"resource\": \"\",\n      \"timestamp\": true\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "5. Cadastrar dispositivo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "fiware-service",
            "value": "smart"
          },
          {
            "key": "fiware-servicepath",
            "value": "/"
          }
        ],
        "url": {
          "raw": "http://{{url}}:4041/iot/devices"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"devices\": [\n    {\n      \"device_id\": \"vinheria001\",\n      \"entity_name\": \"urn:ngsi-ld:IndoorEnvironmentObserved:vinheria001\",\n      \"entity_type\": \"IndoorEnvironmentObserved\",\n      \"protocol\": \"PDI-IoTA-UltraLight\",\n      \"transport\": \"MQTT\",\n      \"timestamp\": true,\n      \"commands\": [\n        {\n          \"name\": \"on\",\n          \"type\": \"command\"\n        },\n        {\n          \"name\": \"off\",\n          \"type\": \"command\"\n        }\n      ],\n      \"attributes\": [\n        {\n          \"object_id\": \"t\",\n          \"name\": \"temperature\",\n          \"type\": \"Number\"\n        },\n        {\n          \"object_id\": \"h\",\n          \"name\": \"relativeHumidity\",\n          \"type\": \"Number\"\n        },\n        {\n          \"object_id\": \"l\",\n          \"name\": \"illuminance\",\n          \"type\": \"Number\"\n        }\n      ]\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "6. Ativar historico (STH-Comet)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "fiware-service",
            "value": "smart"
          },
          {
            "key": "fiware-servicepath",
            "value": "/"
          }
        ],
        "url": {
          "raw": "http://{{url}}:1026/v2/subscriptions"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Historico da Vinheria no STH-Comet\",\n  \"subject\": {\n    \"entities\": [\n      {\n        \"id\": \"urn:ngsi-ld:IndoorEnvironmentObserved:vinheria001\",\n        \"type\": \"IndoorEnvironmentObserved\"\n      }\n    ],\n    \"condition\": {\n      \"attrs\": [\n        \"temperature\",\n        \"relativeHumidity\",\n        \"illuminance\"\n      ]\n    }\n  },\n  \"notification\": {\n    \"http\": {\n      \"url\": \"http://{{url}}:8666/notify\"\n    },\n    \"attrs\": [\n      \"temperature\",\n      \"relativeHumidity\",\n      \"illuminance\"\n    ],\n    \"attrsFormat\": \"legacy\"\n  }\n}"
        }
      }
    },
